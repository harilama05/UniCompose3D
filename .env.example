# Copy to .env. Environment variables override this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
TRYON_LLM_PROVIDER=openai
OPENAI_COMPOSITION_REASONING_EFFORT=medium
TRYON_DEFAULT_PROVIDER=hunyuan
TRYON_SEARCH_MAX_STARTS=16
TRYON_SEARCH_MAX_PROGRAMS=4
TRYON_SEARCH_MAX_SECONDS=60
# Optional local paths; configure GPU models using docs/kaggle.md.
# TRYON_DATA_DIR=./data
# TRYON_HUNYUAN_PYTHON=/path/to/model-env/bin/python
# TRYON_HUNYUAN_DIR=/path/to/Hunyuan3D-2
# TRYON_QUALITY_WEIGHTS=/path/to/weights
# TRYON_SEGMENT_PYTHON=/path/to/model-env/bin/python
# TRYON_SEGMENT_WEIGHTS=/path/to/weights
